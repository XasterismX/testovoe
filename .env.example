# Все значения имеют дефолты в docker-compose.yml; скопируйте в .env для переопределения.
APP_PORT=8080
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=taskmanager
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_PORT=3306
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=24h
CACHE_TTL=5m
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
